# ==============================================================================
# NEXUS ERP - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (SHOWCASE)
# ==============================================================================
# Renomeie este arquivo para .env.local para executar em ambiente de desenvolvimento.

# 1. SUPABASE (Banco de Dados PostgreSQL, Autenticação, Storage e RLS)
# Obtenha os valores no seu painel em: Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-do-supabase

# 2. GOOGLE GEMINI AI (Extração Inteligente de PDFs e OCR de Empenhos / Atas)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
VITE_GOOGLE_API_KEY=sua-chave-api-gemini

# 3. GOOGLE CALENDAR (Opcional - Sincronização de Prazos de Entrega / SLA)
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# 4. MODO DEMONSTRAÇÃO (Opcional - Exibe badge e dados mockados na interface)
VITE_IS_DEMO=false
